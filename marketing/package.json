		"@testing-library/svelte": "^5.3.1",
		"daisyui": "^5.5.23",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
