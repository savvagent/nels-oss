# PostgreSQL database connection URL with pgvector support
DATABASE_URL=postgres://postgres:postgrespassword@127.0.0.1:6153/budget_rag

# Google Gemini API key (for gemini-embedding-001 768-d embeddings and gemini-2.5-flash chat)
# If omitted, the backend will run in a mock offline pattern-matching mode for demo/testing
GEMINI_API_KEY=

# --- AI model providers and bring-your-own-key (nels-oss#3) ---
# Base-URL test seams for the three model providers. Leave ALL of these unset in
# production (blank means the real API). Tests point them at a local mock server.
# GEMINI_API_BASE=
# OPENAI_API_BASE=
# ANTHROPIC_API_BASE=
# Server-wide model per provider. Unset or blank uses the pinned default
# (gemini-2.5-flash, gpt-4.1-mini, claude-haiku-4-5). Run the eval before changing.
# LLM_MODEL_GEMINI=
# LLM_MODEL_OPENAI=
# LLM_MODEL_ANTHROPIC=
# Comma-separated BYO providers offered in Settings (gemini,openai,anthropic).
# UNSET MEANS ALL THREE, so production must set this explicitly to the providers
# that passed the eval gate (see AGENTS.md section 27 and docs/evals/).
# ENABLED_BYO_PROVIDERS=

# Base64-encoded 32-byte key used to encrypt TOTP secrets at rest (AES-256-GCM).
# REQUIRED — the backend refuses to start without it. Generate one with:
#   openssl rand -base64 32
TOTP_ENC_KEY=

# Drop pgvector embeddings on chat messages older than this many days
# (readable message text is preserved). Optional; defaults to 90.
EMBEDDING_RETENTION_DAYS=90

# Always keep embeddings for the most recent N messages of each conversation,
# regardless of age. Optional; defaults to 50.
EMBEDDING_RETENTION_KEEP_RECENT=50

# Retention for the audit_logs table. Rows older than this many days are purged
# hourly. Optional; defaults to 365.
AUDIT_LOG_RETENTION_DAYS=365

# Retention for the notifications table. READ notifications older than
# NOTIFICATION_READ_RETENTION_DAYS and UNREAD notifications older than
# NOTIFICATION_UNREAD_RETENTION_DAYS are purged hourly. Unread are kept longer so
# unseen alerts are not lost. Optional; default 30 (read) / 90 (unread).
NOTIFICATION_READ_RETENTION_DAYS=30
NOTIFICATION_UNREAD_RETENTION_DAYS=90

# GitHub integration for the chat command palette (#56): /issues-list and
# /issues-create. OPTIONAL — if GITHUB_TOKEN is unset, those commands degrade
# gracefully with a clear "not configured" message (the rest of the app is
# unaffected). The token is used only server-side and is NEVER sent to the
# client. Use a fine-grained personal access token scoped to *Issues: read &
# write* on the target repo only (least privilege).
#   In production: fly secrets set GITHUB_TOKEN=... -a nels-api
GITHUB_TOKEN=

# owner/repo the command palette reads/creates issues in. Optional; defaults to
# savvagent/nels.
GITHUB_REPO=savvagent/nels

# Stripe subscription billing (#25). All OPTIONAL at the code level — the
# checkout/portal/webhook endpoints return 503 ("not configured") until these are
# set (GET /api/billing/subscription still returns a free/empty 200), so the rest
# of the app runs without Stripe. Use TEST-MODE keys for dev/staging; only production
# uses live keys. Restricted (least-privilege) keys only; never commit secrets.
#   In production: fly secrets set STRIPE_SECRET_KEY=... -a nels-api
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Trial length in days for the Pro subscription. Optional; defaults to 7 to match
# marketing/src/lib/site.js (the issue's "14" predates PR #218's pricing change).
STRIPE_TRIAL_DAYS=7

# Base URL of the app, used for Checkout success/cancel + Customer Portal return
# URLs. Optional; defaults to http://localhost:5173.
APP_URL=

# Stripe API base override for tests/mocks (mirrors GITHUB_API_BASE). Leave UNSET
# in production — defaults to https://api.stripe.com.
STRIPE_API_BASE=

# Financial Connections bank-account linking (#303). Registered as a SEPARATE
# Stripe webhook endpoint from the billing one above, with its own signing
# secret.
STRIPE_FC_WEBHOOK_SECRET=

# GoCardless Bank Account Data (nels#320) — bank linking for UK/FR/DE/IT/ES/DK/FI/NO
#   In production: fly secrets set GOCARDLESS_SECRET_ID=... GOCARDLESS_SECRET_KEY=... -a nels-api
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_API_BASE=
GOCARDLESS_ACCESS_VALID_DAYS=90
GOCARDLESS_MAX_HISTORICAL_DAYS=90
GOCARDLESS_POLL_INTERVAL_HOURS=8

# Plaid bank-account linking (nels#321) — Canada only.
#   In production: fly secrets set PLAID_CLIENT_ID=... PLAID_SECRET=... -a nels-api
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_API_BASE=
# Must exactly match a redirect URI registered in the Plaid Dashboard (needed
# for Big-5 Canadian banks' OAuth flow). Defaults to "{APP_URL}/" if unset.
PLAID_REDIRECT_URI=

# Plaid Investments (nels#468) — dedicated investments-only Link, US only. Uses
# the SAME PLAID_CLIENT_ID/PLAID_SECRET/PLAID_API_BASE as the #321 cash flow;
# the polling interval governs how often active investment accounts are synced.
# Leave PLAID_API_BASE unset in production (defaults to the real Plaid API);
# tests point it at a local mock server, mirroring the other provider seams.
INVESTMENTS_POLL_INTERVAL_HOURS=8

# Retirement planner dashboard (#469) feature flag. Read at request time by the
# backend and surfaced via GET /api/auth/me (`retirement_planner_enabled`), so it
# can be flipped on/off in production without a redeploy:
#   In production: fly secrets set RETIREMENT_PLANNER_ENABLED=true -a nels-api
# Default OFF — the planner UI is hidden (menu entry, route, chat auto-navigation)
# until a deployment deliberately sets this.
RETIREMENT_PLANNER_ENABLED=false
