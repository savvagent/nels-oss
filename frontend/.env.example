# Frontend build-time configuration. Vite inlines VITE_* vars at BUILD time
# (`pnpm dev` / `pnpm build`), so these must be set BEFORE building — changing
# them requires a rebuild. Copy this file to `frontend/.env` for local dev
# (real .env files are gitignored). CI sets these in .github/workflows/deploy-frontend.yml.

# Base URL of the Nels backend API. Optional in dev — defaults to
# http://localhost:3000/api (see src/App.svelte). CI points it at the deployed
# API (https://nels-api.fly.dev/api).
VITE_API_BASE=http://localhost:3000/api

# Stripe publishable key for US bank-account linking via Stripe Financial
# Connections (#303). Publishable keys are safe to ship in the client bundle
# (they are NOT secret). REQUIRED for the US "Link a bank account" flow — if
# unset, loadStripe() throws "Expected publishable key to be of type string,
# got type undefined". Use a pk_test_... key for dev, pk_live_... in production.
#   Production: set as a GitHub Actions secret named VITE_STRIPE_PUBLISHABLE_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=
